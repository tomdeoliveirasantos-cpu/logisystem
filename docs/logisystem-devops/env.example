# ── Banco de dados ─────────────────────────────
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# Ou campos separados (evita problema com @ e # na senha):
# DB_HOST=15.235.54.115
# DB_PORT=5432
# DB_NAME=wsdevsof_reciclagem
# DB_USER=wsdevsof_dev
# DB_PASS=sua_senha_aqui

# ── Servidor ──────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Autenticação JWT ──────────────────────────
# Gere um valor seguro: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque_por_um_valor_aleatorio_seguro_aqui
